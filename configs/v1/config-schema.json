{
  "schema_version": 1,
  "modules": [
    {
      "key": "sigcheck",
      "label": "签名校验",
      "desc": "防移动端98%",
      "type": "leaf",
      "default": true,
      "arg": "--sigcheck"
    },
    {
      "key": "dex2c",
      "label": "Dex2C",
      "desc": "java层代码抽至so层",
      "type": "parent",
      "default": false,
      "arg": "--dex2c",
      "children": [
        {
          "key": "rules_file",
          "label": "类名规则",
          "type": "text",
          "multiline": true,
          "default": "",
          "value_kind": "rules_file",
          "required": {
            "when": "always",
            "unless": { "key": "sigcheck", "is": true }
          },
          "hint": "联合签名校验时可留空（自动抽主类）"
        }
      ]
    },
    {
      "key": "stringenc",
      "label": "字符串加密",
      "desc": "dex字符串加密（防字符串搜索）",
      "type": "parent",
      "default": false,
      "arg": "--stringenc",
      "children": [
        {
          "key": "rules_file",
          "label": "类名规则",
          "type": "text",
          "multiline": true,
          "default": "",
          "value_kind": "rules_file",
          "required": { "when": "always" },
          "hint": "每行一条，支持 **/com.test.** / activity*"
        }
      ]
    },
    {
      "key": "lightobf",
      "label": "轻量混淆",
      "desc": "dex层private标识符改名+数字混淆+指令替换，预算制膨胀",
      "type": "parent",
      "default": false,
      "arg": "--light-obf",
      "children": [
        {
          "key": "mode",
          "label": "混淆强度",
          "type": "select",
          "default": "dab",
          "value_kind": "flags",
          "options": [
            { "value": "d", "label": "标识符改名(变换D)" },
            { "value": "da", "label": "标识符+指令替换(D+A)" },
            { "value": "dab", "label": "标识符+数字混淆+指令替换(D+A+B,推荐)" }
          ]
        },
        {
          "key": "rules_file",
          "label": "类名规则",
          "type": "text",
          "multiline": true,
          "default": "",
          "value_kind": "rules_file",
          "required": { "when": "always" },
          "hint": "支持 **/com.test.** / !排除行 / # 注释"
        }
      ]
    },
    { "key": "antidiff", "label": "防对比混淆", "desc": "dex层结构噪声", "type": "leaf", "default": false, "arg": "--anti-diff" },
    { "key": "envcheck", "label": "环境检测", "desc": "Frida/Xposed/调试器", "type": "leaf", "default": false, "arg": "--envcheck" }
  ]
}
