{
  "schema_version": 1,
  "modules": [
    {
      "key": "sigcheck",
      "label": "签名校验",
      "desc": "防移动端98%",
      "type": "leaf",
      "default": true,
      "arg": "--sigcheck"
    },
    {
      "key": "dcc",
      "label": "DCC",
      "desc": "java层代码抽至so层（经典引擎）",
      "type": "parent",
      "default": false,
      "arg": "--dcc",
      "children": [
        {
          "key": "rules_file",
          "label": "类名规则",
          "type": "text",
          "multiline": true,
          "default": "",
          "value_kind": "rules_file",
          "required": {
            "when": "always",
            "unless": { "key": "sigcheck", "is": true }
          },
          "hint": "联合签名校验时可留空（自动抽主类）"
        }
      ]
    },
    {
      "key": "dex2c",
      "label": "Dex2C",
      "desc": "java层代码抽至so层（新引擎，规则与契约同DCC）",
      "type": "parent",
      "default": false,
      "arg": "--dex2c",
      "children": [
        {
          "key": "rules_file",
          "label": "类名规则",
          "type": "text",
          "multiline": true,
          "default": "",
          "value_kind": "rules_file",
          "required": {
            "when": "always",
            "unless": { "key": "sigcheck", "is": true }
          },
          "hint": "联合签名校验时可留空（自动抽主类）"
        }
      ]
    },
    {
      "key": "stringenc",
      "label": "字符串加密",
      "desc": "dex字符串加密（防字符串搜索）",
      "type": "parent",
      "default": false,
      "arg": "--stringenc",
      "children": [
        {
          "key": "rules_file",
          "label": "类名规则",
          "type": "text",
          "multiline": true,
          "default": "",
          "value_kind": "rules_file",
          "required": { "when": "always" },
          "hint": "每行一条，支持 **/com.test.** / activity*"
        }
      ]
    },
    {
      "key": "antidiff",
      "label": "防对比混淆",
      "desc": "dex层结构噪声",
      "type": "leaf",
      "default": false,
      "arg": "--anti-diff"
    },
    { "key": "envcheck", "label": "环境检测", "desc": "Frida/Xposed/调试器", "type": "leaf", "default": false, "arg": "--envcheck" },
    { "key": "packer", "label": "基础加壳", "desc": "dex整体加密（须最后执行）", "type": "parent", "default": false, "arg": "--packer", "children": [
      { "key": "smaller", "label": "体积优化", "desc": "性价比极高", "type": "checkbox", "default": true, "value_kind": "flag", "arg_on": "--packer-smaller" },
      { "key": "exclude_x86", "label": "排除模拟器架构", "desc": "产物剔除 x86/x86_64 的 so 目录（多数手机只需 arm/arm64）；代价：x86 模拟器无法安装运行加壳包", "type": "checkbox", "default": false, "value_kind": "arg_value", "arg_on": "--exclude-abi", "arg_value": "x86,x86_64" }
    ] }
  ]
}
